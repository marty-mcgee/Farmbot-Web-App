    ToolTips.DOT_NOTATION_TIP = (0, _util.trim)("Tip: Use dot notation (i.e., 'meta.color') to access meta fields.");
    ToolTips.MOVE = (0, _util.trim)("Use these manual control buttons to move FarmBot in realtime.\n    Press the arrows for relative movements or type in new coordinates\n    and press GO for an absolute movement.\n    Tip: Press the Home button when you are done so FarmBot is ready to\n    get back to work.");
    ToolTips.WEBCAM = (0, _util.trim)("If you have a webcam, you can view the video stream in this widget.\n    Press the edit button to update and save your webcam URL.\n    Note: Some webcam services do not allow webcam feeds to be embedded in\n    other sites. If you see a web browser error after adding a webcam feed,\n    there is unfortunately nothing FarmBot can do to fix the problem.\n    Please contact your webcam's customer support to see if the security\n    policy for embedding feeds into other sites can be changed.");
    ToolTips.PERIPHERALS = (0, _util.trim)("Use these toggle switches to control FarmBot's peripherals in\n    realtime. To edit and create new peripherals, press the EDIT button.\n    Make sure to turn things off when you're done!");
    ToolTips.PINNED_SEQUENCES = (0, _util.trim)("Pin a sequence in the sequence editor to add it to this list.");
    ToolTips.SENSORS = (0, _util.trim)("Add sensors here to monitor FarmBot's sensors.\n    To edit and create new sensors, press the EDIT button.");
    ToolTips.SENSOR_HISTORY = (0, _util.trim)("View and filter historical sensor reading data.");
    ToolTips.VOLTAGE_STATUS = (0, _util.trim)("Raspberry Pi power status since last reboot. If supply voltage\n    drops below the standard operational threshold the indicator will turn\n    red. Once the voltage level recovers the status will turn yellow,\n    indicating that a low voltage event has occurred. Low voltage may\n    adversely affect WiFi and camera functionality.");
    ToolTips.FIRMWARE_VALUE_API = (0, _util.trim)("Firmware value from your choice in the dropdown to the right, as\n    understood by the Web App.");
    ToolTips.FIRMWARE_VALUE_FBOS = (0, _util.trim)("Firmware value reported from the firmware, as understood by\n    FarmBot OS.");
    ToolTips.FIRMWARE_VALUE_MCU = (0, _util.trim)("Firmware value reported from the firmware.");
    ToolTips.RPI_VALUE_API = (0, _util.trim)("Raspberry Pi model from your choice in the dropdown to the right,\n    as understood by the Web App.");
    ToolTips.RPI_VALUE_FBOS = (0, _util.trim)("Raspberry Pi model reported from your device, as understood by\n    FarmBot OS.");
    ToolTips.HW_SETTINGS = (0, _util.trim)("Caution: Changing these settings to extreme values can cause\n    hardware malfunction. Make sure to test any new settings to verify\n    that everything works as expected before letting your FarmBot use\n    them unsupervised.");
    ToolTips.FIND_HOME_ENCODERS = (0, _util.trim)("If encoders or limit switches are enabled, find home for\n    an axis (set zero position).");
    ToolTips.FIND_HOME_STALL_DETECTION = (0, _util.trim)("If stall detection or limit switches are enabled, find home for\n    an axis (set zero position).");
    ToolTips.FIND_LENGTH_ENCODERS = (0, _util.trim)("If encoders or limit switches are enabled, home axis and determine\n    maximum. Will set axis length value.");
    ToolTips.FIND_LENGTH_STALL_DETECTION = (0, _util.trim)("If stall detection or limit switches are enabled, home axis and\n    determine maximum. Will set axis length value.");
    ToolTips.SET_AXIS_LENGTH = (0, _util.trim)("Set axis length to the current FarmBot axis position.");
    ToolTips.SET_HOME_POSITION = (0, _util.trim)("Set the current location as home (zero).");
    ToolTips.FIND_HOME_ON_BOOT_ENCODERS = (0, _util.trim)("If encoders or limit switches are enabled, find the home position\n    when the device powers on. Warning! This will perform homing on all\n    axes when the device powers on. Encoders or limit switches must be enabled.\n    It is recommended to make sure homing works properly before enabling\n    this feature. (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.FIND_HOME_ON_BOOT_STALL_DETECTION = (0, _util.trim)("If stall detection or limit switches are enabled, find the home\n    position when the device powers on. Warning! This will perform homing\n    on all axes when the device powers on. Stall detection or limit switches\n    must be enabled. It is recommended to make sure homing works properly\n    before enabling this feature. (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.STOP_AT_HOME = (0, _util.trim)("Stop at the home (zero) location of the axis. If enabled, moving\n    past zero is disallowed. (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.STOP_AT_MAX = (0, _util.trim)("Don't allow movement past the maximum value provided in AXIS LENGTH\n    (for AXIS LENGTH values other than '0').\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.NEGATIVE_COORDINATES_ONLY = (0, _util.trim)("Restrict travel to negative coordinate locations.\n    Overridden by disabling STOP AT HOME.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.CALIBRATION_RETRIES = (0, _util.trim)("Number of times to retry calibration.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.CALIBRATION_TOTAL_RETRIES = (0, _util.trim)("Total number of times to retry calibration.\n      (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.CALIBRATION_RETRY_RESET_DISTANCE = (0, _util.trim)("Distance in millimeters to group calibration retries. If the\n    distance traveled while detecting the axis end location exceeds this\n    value, the calibration retry counter is reset.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.AXIS_LENGTH = (0, _util.trim)("Set the length of each axis to provide software limits.\n    Used only if STOP AT MAX is enabled.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }} (disabled))");
    ToolTips.GANTRY_HEIGHT = (0, _util.trim)("The **GANTRY HEIGHT** is the distance in millimeters between the\n    bottom of FarmBot's tool head and the bottom of the gantry main beam\n    when the Z-axis is fully raised. It is used to determine if a plant is\n    too tall for the gantry to pass over it. (default: {{ distance }})");
    ToolTips.SAFE_HEIGHT = (0, _util.trim)("Z axis coordinate (millimeters) to which the z axis should be\n    retracted during Safe Z moves. It is recommended to choose a value at\n    which the z axis is all of the way up to provide as much clearance as\n    possible. (default: 0)");
    ToolTips.FALLBACK_SOIL_HEIGHT = (0, _util.trim)("Z axis coordinate (millimeters) of soil level. This value will\n    only be used if there are no soil height measurements available. To add\n    soil height measurements, run a sequence with the MEASURE SOIL HEIGHT\n    command in a grid over your garden. Alternatively, use a ruler to\n    manually measure the height at various locations in the garden and add\n    corresponding soil height points from the points panel. (default: -500)");
    ToolTips.DEFAULT_AXIS_ORDER = (0, _util.trim)("Default axis order for movement. (default: X and Y together)");
    ToolTips.MAX_SPEED = (0, _util.trim)("Maximum travel speed after acceleration in millimeters per second.\n    (default: x: {{ x }}mm/s, y: {{ y }}mm/s, z: {{ z }}mm/s)");
    ToolTips.MAX_SPEED_Z_TOWARD_HOME = (0, _util.trim)("Maximum travel speed after acceleration in millimeters per second.\n    (default: {{ z }}mm/s)");
    ToolTips.HOME_SPEED = (0, _util.trim)("Home position adjustment travel speed (homing and finding axis length)\n    in millimeters per second.\n    (default: x: {{ x }}mm/s, y: {{ y }}mm/s, z: {{ z }}mm/s)");
    ToolTips.MIN_SPEED = (0, _util.trim)("Minimum movement speed in millimeters per second.\n    Also used for homing and finding axis length.\n    (default: x: {{ x }}mm/s, y: {{ y }}mm/s, z: {{ z }}mm/s)");
    ToolTips.MIN_SPEED_Z_TOWARD_HOME = (0, _util.trim)("Minimum movement speed in millimeters per second.\n    Also used for homing and finding axis length.\n    (default: {{ z }}mm/s)");
    ToolTips.ACCELERATE_FOR = (0, _util.trim)("Number of millimeters used for acceleration and deceleration.\n    (default: x: {{ x }}mm, y: {{ y }}mm, z: {{ z }}mm)");
    ToolTips.ACCELERATE_FOR_Z_TOWARD_HOME = (0, _util.trim)("Number of millimeters used for acceleration and deceleration.\n    (default: {{ z }}mm)");
    ToolTips.STEPS_PER_MM = (0, _util.trim)("The number of motor steps required to move the axis one millimeter.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.MICROSTEPS_PER_STEP = (0, _util.trim)("The number of microsteps required to move the motor one step.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.MICROSTEP_WARNING = (0, _util.trim)("A microstep value of 1 is recommended for best performance when\n    quiet motor mode is enabled.");
    ToolTips.ALWAYS_POWER_MOTORS = (0, _util.trim)("Keep power applied to motors. Prevents slipping from gravity in\n    certain situations. (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.INVERT_MOTORS = (0, _util.trim)("Invert direction of motor while finding axis length.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.MOTOR_CURRENT = (0, _util.trim)("Motor current as a percent of maximum.\n    (default: x: {{ x }}%, y: {{ y }}%, z: {{ z }}%)");
    ToolTips.QUIET_MODE = (0, _util.trim)("Enable quiet motors.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.ENABLE_X2_MOTOR = (0, _util.trim)("Enable use of a second x-axis motor. Connects to E0 on RAMPS.\n    (default: {{ x2Motor }})");
    ToolTips.INVERT_X2_MOTOR = (0, _util.trim)("Invert direction of motor. (default: {{ x }})");
    ToolTips.ENABLE_ENCODERS = (0, _util.trim)("Enable use of rotary encoders for stall detection,\n    finding axis length, and homing.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.ENABLE_STALL_DETECTION = (0, _util.trim)("Enable use of motor stall detection for detecting missed steps,\n    finding axis length, and homing.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.STALL_SENSITIVITY = (0, _util.trim)("Motor stall sensitivity. Most sensitive: -63.\n    Least sensitive: +63. (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.USE_ENCODERS_FOR_POSITIONING = (0, _util.trim)("Use the encoders for calculating movements in addition to using\n    encoders for stall detection.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.INVERT_ENCODERS = (0, _util.trim)("Reverse the direction of encoder position reading.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.MAX_MISSED_STEPS_ENCODERS = (0, _util.trim)("Number of steps missed (determined by encoder) before motor is\n    considered to have stalled. (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.MAX_MISSED_STEPS_STALL_DETECTION = (0, _util.trim)("Maximum motor load (determined by stepper driver) before\n    motor is considered to have stalled.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.MISSED_STEP_DECAY_ENCODERS = (0, _util.trim)("Reduction to missed step total for every good step.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.MISSED_STEP_DECAY_STALL_DETECTION = (0, _util.trim)("Travel in millimeters for stall detection to ignore during acceleration.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.ENCODER_SCALING = (0, _util.trim)("encoder scaling factor = 10000 * (motor resolution)\n    / (encoder resolution).\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }} (10000*200/360))");
    ToolTips.ENABLE_LIMIT_SWITCHES = (0, _util.trim)("Enable use of electronic limit switches for end detection,\n    finding axis length, and homing. Limit switches are contact switches or\n    momentary push buttons that can be added to the end of each axis to\n    be engaged when an axis reaches the end.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.SWAP_LIMIT_SWITCHES = (0, _util.trim)("Swap axis minimum and maximum limit switches.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.INVERT_LIMIT_SWITCHES = (0, _util.trim)("Invert axis limit switches. Enable for normally closed (NC),\n    disable for normally open (NO).\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }})");
    ToolTips.TIMEOUT_AFTER = (0, _util.trim)("Amount of time to wait for a command to execute before stopping.\n    (default: x: {{ x }}, y: {{ y }}, z: {{ z }} seconds)");
    ToolTips.MAX_MOVEMENT_RETRIES = (0, _util.trim)("Number of times to retry a movement before stopping.\n    (default: {{ retries }})");
    ToolTips.E_STOP_ON_MOV_ERR = (0, _util.trim)("Emergency stop if movement is not complete after the maximum\n    number of retries. (default: {{ eStopOnError }})");
    ToolTips.PIN_BINDINGS = (0, _util.trim)("Assign an action or sequence to execute when a Raspberry Pi\n    GPIO pin is activated.");
    ToolTips.PIN_BINDING_WARNING = (0, _util.trim)("Warning: Binding to a pin without a physical button and\n    pull-down resistor connected may put FarmBot into an unstable state.");
    ToolTips.PIN_GUARD_PIN_NUMBER = (0, _util.trim)("The number of the pin to guard. This pin will be set to the specified\n    state after the duration specified by TIMEOUT.");
    ToolTips.PIN_REPORTING_PIN_NUMBER = (0, _util.trim)("The number of the pin to report. Analog pin values will be\n    reported every 500ms.");
    ToolTips.PARAMETER_LOAD_PROGRESS = (0, _util.trim)("FarmBot adoption of hardware parameter changes. Tip: If progress\n    does not reach 100% within a few minutes, press RESEND.");
    ToolTips.PARAMETER_IMPORT = (0, _util.trim)("Paste the output from EXPORT PARAMETERS into the text field and\n    press IMPORT to import new hardware parameters to your FarmBot.");
    ToolTips.WEED_DETECTOR = (0, _util.trim)("Detect weeds using FarmBot's camera and display them on the\n    Farm Designer map.");
    ToolTips.SOIL_HEIGHT_DETECTION = (0, _util.trim)("Detect soil height using FarmBot's camera and display the results\n    on the Farm Designer map.");
    ToolTips.CAMERA_CALIBRATION = (0, _util.trim)("Calibrate FarmBot's camera for use in the weed detection software.");
    ToolTips.RED_DOT_CAMERA_CALIBRATION = (0, _util.trim)("Genesis v1.2 through v1.4 bots did not include the camera\n    calibration card. Instead, these kits included red calibration objects\n    and must be calibrated using an alternative method");
    ToolTips.CAMERA_CALIBRATION_CARD_SHOP_LINK = (0, _util.trim)("Camera calibration cards are available in the shop and can be\n    used with any FarmBot version.");
    ToolTips.INVERT_HUE_SELECTION = (0, _util.trim)("Invert the range of hues selected. Typically used to select the\n    full range of reds. (default: {{ defaultInvertState }})");
    ToolTips.OBJECT_SEPARATION = (0, _util.trim)("Distance between calibration objects in millimeters. The distance\n    between the objects on the camera calibration card is 100mm.\n    (default: {{ defaultSeparation }})");
    ToolTips.CALIBRATION_OBJECT_AXIS = (0, _util.trim)("The FarmBot axis along which the calibration objects are aligned.\n    (default: {{ defaultAxis }})");
    ToolTips.CAMERA_OFFSET = (0, _util.trim)("Camera offset from the UTM position in millimeters.\n    Once calibrated, use these values to align photos to the Farm Designer\n    grid by matching the grid and locations in photos to the grid and\n    locations in the Farm Designer.\n    (default: (x: {{ defaultX }}, y: {{ defaultY }}))");
    ToolTips.IMAGE_BOT_ORIGIN_LOCATION = (0, _util.trim)("FarmBot origin (home) location in images. If the origin does not\n    correspond to an image corner, rotate the camera until one does.\n    (default: {{ defaultOrigin }})");
    ToolTips.COORDINATE_SCALE = (0, _util.trim)("Image pixel to FarmBot coordinate scale. Typically between\n    0.1 and 2, this value matches image scale with the FarmBot coordinate\n    system. (default: {{ defaultScale }} (uncalibrated))");
    ToolTips.IMAGE_ROTATION_ANGLE = (0, _util.trim)("Camera rotation in degrees. This value should be minimized\n    (to near zero) by rotating the camera in its mount until it is aligned\n    with FarmBot's axes. (default: {{ defaultAngle }})");
    ToolTips.BLUR = (0, _util.trim)("Image blur kernel size. Must be an odd number greater than 1.\n    (default: {{ defaultBlur }})");
    ToolTips.MORPH = (0, _util.trim)("Size of the structuring element used for morphological\n    transformations. (default: {{ defaultMorph }})");
    ToolTips.ITERATIONS = (0, _util.trim)("Number of erosion and dilation morphological transformation\n    cycles. (default: {{ defaultIteration }})");
    ToolTips.COLOR_HUE_RANGE = (0, _util.trim)("Color range.\n    (default: {{ defaultLow }} - {{ defaultHigh }} ({{ defaultColor }}))");
    ToolTips.COLOR_SATURATION_RANGE = (0, _util.trim)("Color saturation, 0 (white) to 255 (color).\n    (default: {{ defaultLow }} - {{ defaultHigh }})");
    ToolTips.COLOR_VALUE_RANGE = (0, _util.trim)("Color value, 0 (black) to 255 (color)\n    (default: {{ defaultLow }} - {{ defaultHigh }})");
    ToolTips.SAVE_DETECTED_PLANTS = (0, _util.trim)("Save detected plants as map points. (default: {{ defaultSavePlants }})");
    ToolTips.USE_BOUNDS = (0, _util.trim)("Don't save weeds detected outside of garden bed.\n    (default: {{ defaultUseBounds }})");
    ToolTips.MIN_RADIUS = (0, _util.trim)("Minimum weed size (diameter) in millimeters. Set to 0 to disable limit.\n    (default: {{ defaultMinDiameter }})");
    ToolTips.MAX_RADIUS = (0, _util.trim)("Maximum weed size (diameter) in millimeters. Set to 0 to disable limit.\n    (default: {{ defaultMaxDiameter }})");
    ToolTips.SEQUENCE_COMMANDS = (0, _util.trim)("These are the most basic commands FarmBot can execute. Drag and drop\n    them to create sequences for watering, planting seeds, measuring soil\n    properties, and more.");
    ToolTips.SEQUENCE_EDITOR = (0, _util.trim)("Drag and drop commands here to create sequences for watering,\n    planting seeds, measuring soil properties, and more.\n    Press the Test button to immediately try your sequence with FarmBot.\n    You can also edit, copy, and delete existing sequences;\n    assign a color; and give your commands custom names.");
    ToolTips.DEFAULT_VALUE = (0, _util.trim)("Select a default value for this variable.\n    If the sequence is ever run without the variable explicitly set to\n    another value, the default value will be used.");
    ToolTips.USING_DEFAULT_VARIABLE_VALUE = (0, _util.trim)("No location selected. Using default value.");
    ToolTips.COMPUTED_MOVE = (0, _util.trim)("The Move step instructs FarmBot to move to the specified\n    coordinate or distance from its current location.");
    ToolTips.AXIS_ORDER = (0, _util.trim)("If \"Safe Z\" is chosen, FarmBot will: (1) Move Z to the Safe Z height,\n    (2) Move X and Y to the new location, and (3) Move Z to the new location.");
    ToolTips.MOVE_ABSOLUTE = (0, _util.trim)("The Move To step instructs FarmBot to move to the specified\n    coordinate regardless of the current position. For example, if FarmBot is\n    currently at X=1000, Y=1000 and it receives a Move To where X=0 and\n    Y=3000, then FarmBot will move to X=0, Y=3000. If FarmBot must move in\n    multiple directions, it will move diagonally. If you require straight\n    movements along one axis at a time, use multiple Move To steps.\n    Offsets allow you to more easily instruct FarmBot to move to a location,\n    but offset from it by the specified amount. For example moving to just\n    above where a peripheral is located. Using offsets lets FarmBot do the\n    math for you.");
    ToolTips.MOVE_RELATIVE = (0, _util.trim)("The Move Relative step instructs FarmBot to move the specified\n    distance from its current location. For example, if FarmBot is\n    currently at X=1000, Y=1000 and it receives a Move Relative\n    where X=0 and Y=3000, then FarmBot will move to X=1000, Y=4000.\n    If FarmBot must move in multiple directions, it will move diagonally.\n    If you require straight movements along one axis at a time,\n    use multiple Move Relative steps. Move Relative steps should be\n    preceded by a Move To step to ensure you are starting from a known\n    location.");
    ToolTips.WRITE_PIN = (0, _util.trim)("The Control Peripheral step instructs FarmBot to set the\n    specified pin on the Arduino to the specified mode and value.\n    Use the digital pin mode for on (1) and off (0) control,\n    and analog pin mode for PWM (pulse width modulation) (0-255).");
    ToolTips.READ_PIN = (0, _util.trim)("The Read Sensor step instructs FarmBot to read the\n    current value of the specified sensor or peripheral.\n    Pin Mode: Use digital for a 0 (LOW) or 1 (HIGH) response,\n    and analog for a voltage reading (0-1023 for 0-5V).");
    ToolTips.WAIT = (0, _util.trim)("The Wait step instructs FarmBot to wait for the specified amount\n    of time. Use it in combination with the Control Peripheral step to\n    water for a length of time.");
    ToolTips.SEND_MESSAGE = (0, _util.trim)("The Send Message step instructs FarmBot to send a custom message\n    to the logs (and toast message and/or email, if selected). This can\n    help you with debugging your sequences.");
    ToolTips.FIND_HOME = (0, _util.trim)("The Find Home step instructs the device to perform a homing\n    command (using encoders, stall detection, or limit switches) to find and set\n    home (zero) for the chosen axis or axes.");
    ToolTips.CALIBRATE = (0, _util.trim)("If encoders, stall detection, or limit switches are enabled,\n    home axis and determine maximum. Will set axis length value.");
    ToolTips.IF = (0, _util.trim)("Execute a sequence if a condition is satisfied. If the condition\n    is not satisfied, chose to do nothing or execute a different sequence.");
    ToolTips.EXECUTE_SEQUENCE = (0, _util.trim)("No description provided for this subsequence.");
    ToolTips.EXECUTE_SCRIPT = (0, _util.trim)("The Run Farmware step runs a Farmware package.\n    Visit the Farmware panel to install and manage Farmware.");
    ToolTips.DETECT_WEEDS = (0, _util.trim)("The Detect Weeds step takes a photo and detects any weeds in the area.\n    Visit the Photos panel to view results or change parameters.");
    ToolTips.MEASURE_SOIL_HEIGHT = (0, _util.trim)("The Measure Soil Height step takes a photo and detects the\n    z-axis coordinate of the visible soil surface. Visit the Points panel\n    to view results or visit the Farmware panel to change parameters.");
    ToolTips.FARMWARE_CONFIGS = (0, _util.trim)("The Farmware will use the parameter values set via the Farmware\n    panel for any parameters that are not set in this sequence step.");
    ToolTips.TAKE_PHOTO = (0, _util.trim)("Snaps a photo using the device camera. Select the camera type\n    in the Settings panel.");
    ToolTips.EMERGENCY_LOCK = (0, _util.trim)("Stops a device from moving until it is unlocked by a user.");
    ToolTips.SELECT_A_CAMERA = (0, _util.trim)("Select a camera on the Settings panel to take photos.");
    ToolTips.ROTATE_IMAGE_AT_CAPTURE = (0, _util.trim)("Perform camera rotation compensation when image is captured\n    instead of in garden map. If enabled, image files will include\n    adjustment for camera rotation (black angled borders may show in\n    viewer). Enabling this setting will slow down photo capture.");
    ToolTips.IMAGE_RESOLUTION = (0, _util.trim)("The camera will capture images at the closest available resolution\n    to the selected size. Changing image resolution requires recalibration\n    of the camera. Higher quality images will take longer to process.");
    ToolTips.CALIBRATION_REQUIRED = (0, _util.trim)("Calibrate your camera in the Photos panel before detecting weeds.");
    ToolTips.MARK_AS = (0, _util.trim)("The Mark As step allows FarmBot to programmatically edit the\n    properties of the UTM, plants, and weeds from within a sequence.\n    For example, you can mark a plant as \"planted\" during a seeding\n    sequence or mark a weed as \"removed\" after removing it.");
    ToolTips.SET_SERVO_ANGLE = (0, _util.trim)("Move a servo to the provided angle. An angle of 90 degrees\n    corresponds to the servo midpoint (or, for a continuous rotation\n    servo, no movement). Tip: follow with a WAIT command to allow the servo\n    to reach the target position.");
    ToolTips.TOGGLE_PIN = (0, _util.trim)("Toggle a digital pin on or off.");
    ToolTips.MOVE_TO_HOME = (0, _util.trim)("Move FarmBot to home for the provided axis.");
    ToolTips.ASSERTION = (0, _util.trim)("Evaluate Lua commands. For power users and software developers.");
    ToolTips.LUA = (0, _util.trim)("Execute Lua commands. For power users and software developers.");
    ToolTips.FIRMWARE_ACTION = (0, _util.trim)("FarmBot OS or micro-controller firmware action.");
    ToolTips.SYSTEM_ACTION = (0, _util.trim)("FarmBot OS action.");
    ToolTips.UNKNOWN_STEP = (0, _util.trim)("Unable to properly display this step.");
    ToolTips.THREE_D_BED_WALL_THICKNESS = (0, _util.trim)("Bed wood thickness. (default: {{ defaultConfigValue }}mm)");
    ToolTips.THREE_D_BED_HEIGHT = (0, _util.trim)("Bed height. (default: {{ defaultConfigValue }}mm)");
